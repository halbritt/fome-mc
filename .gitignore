# For PCBs designed using KiCad: https://www.kicad.org/
# Format documentation: https://kicad.org/help/file-formats/

# Temporary files
*.000
*.bak
*.bck
*.kicad_pcb-bak
*.kicad_pcb.lck
*.kicad_sch-bak
*.kicad_sch.lck
*-backups
*.kicad_prl
*.sch-bak
*~
~*.lck
_autosave-*
*.tmp
*-save.pro
*-save.kicad_pcb
fp-info-cache

# Netlist files (exported from Eeschema)
*.net

# Autorouter files (exported from Pcbnew)
*.dsn
*.ses

# Backup files 
*polygonus-Shortage-Version-backups/

# Exported BOM files
*.xml
gerber/
production_files/

# --- EDA toolchain (toolchain/README.md) ---
build/
toolchain/.venv/
toolchain/vendor/
__pycache__/
# Committed toolchain reports keep their netlists/BOMs despite the rules above.
!reports/toolchain/**
!export/fome-mc.net
!export/BOM-fome-mc.csv
!export/CPL-fome-mc.csv
