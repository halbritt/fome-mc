#!/usr/bin/env bash
# ee446g source capture: official JLCPCB / TE URLs only, original bytes retained. Usage: capture.sh OUTDIR
set -u
out=$1; mkdir -p "$out"
fetch() {  # fetch <name> <url>
  local name=$1 url=$2 t
  t=$(date -u +%Y-%m-%dT%H:%M:%SZ)
  curl -sS --max-time 60 -D "$out/$name.headers" -o "$out/$name.body" -w '%{http_code} %{url_effective} %{size_download}\n' "$url" > "$out/$name.meta" 2> "$out/$name.err"
  printf '%s rc=%s time=%s url=%s -> %s' "$name" "$?" "$t" "$url" "$(cat "$out/$name.meta")"
}
fetch jlc-pcb-capabilities 'https://jlcpcb.com/capabilities/pcb-capabilities'
fetch te-108-1329 'https://www.te.com/commerce/DocumentDelivery/DDEController?Action=srchrtrv&DocLang=English&PartCntxt=1-776163-1&DocFormat=pdf&DocNm=108-1329&DocType=Specification+Or+Standard'
